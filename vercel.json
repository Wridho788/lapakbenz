{
  "rewrites": [
    {
      "source": "/event",
      "destination": "/index.html"
    },
    {
      "source": "/product",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/myprofile",
      "destination": "/index.html"
    },
    {
      "source": "/notifications",
      "destination": "/index.html"
    },
    {
      "source": "/orders",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/verify-otp",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/invoice/:invoiceId",
      "destination": "/index.html"
    },
    {
      "source": "/payment-confirmation",
      "destination": "/index.html"
    },
    {
      "source": "/change-password",
      "destination": "/index.html"
    },
    {
      "source": "/live-chat",
      "destination": "/index.html"
    },
    {
      "source": "/product/:productId",
      "destination": "/index.html"
    },
    {
      "source": "/event/:eventId",
      "destination": "/index.html"
    },
    {
      "source": "/merchant-registration/:eventId",
      "destination": "/index.html"
    },
    {
      "source": "/public-registration/:eventId",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:tab",
      "destination": "/index.html"
    },
    {
      "source": "/order/:orderId",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
